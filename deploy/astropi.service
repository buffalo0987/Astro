[Unit]
Description=AstroPi Headless Polar Alignment, Framing & Sequencing Daemon
After=network.target avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/astropi/backend
Environment="ASTROPI_ROOT=/opt/astropi"
Environment="ASTROPI_DATA_DIR=/var/lib/astropi"
Environment="ASTROPI_CAPTURES_DIR=/var/lib/astropi/captures"
Environment="ASTROPI_SHM_DIR=/dev/shm/astropi"
Environment="ASTROPI_ASTAP_DB=/opt/astap"
ExecStartPre=/bin/mkdir -p /dev/shm/astropi /var/lib/astropi/captures
ExecStart=/opt/astropi/venv/bin/python3 -m app.main
Restart=always
RestartSec=3
Nice=-10
MemoryMax=512M
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
